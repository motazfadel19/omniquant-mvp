# ---------------------------------------------------------------------------
# Copy to backend/.env and adjust. The file is git-ignored.
# ---------------------------------------------------------------------------

# paper = simulate every order (nothing reaches the broker)
# live  = real orders. The server refuses to boot in live mode with the default
#         token or without TRADING_MODE being set explicitly.
TRADING_MODE=paper

# Must match NEXT_PUBLIC_AUTH_TOKEN in frontend/.env.local.
# Shipped EMPTY on purpose: with no real secret the server refuses every write
# (HTTP 503) instead of trusting a value that anyone can read on GitHub.
# Generate one with:  python backend/tools/setup_env.py
AUTH_TOKEN=

# ---------------- instruments ----------------
STREAM_SYMBOLS=XAUUSD
HEATMAP_SYMBOLS=XAUUSD
ALLOWED_SYMBOLS=
# empty = both directions. Setting "BUY" reproduces the old BUY-only behaviour,
# but do it deliberately and document why.
ALLOWED_DIRECTIONS=

# ---------------- position sizing ----------------
MAX_LOT_SIZE=0.5
DEFAULT_LOT_SIZE=0.01

# ---------------- strategy (shared by backtest AND live engine) ----------------
MIN_SCORE=0.50
MIN_CONFLUENCES=3
STRONGER_BY=1.5
MIN_CONFIDENCE=0.30
SL_ATR_MULT=1.5
TP_ATR_MULT=2.5
MAX_BARS_HELD=50

# ---------------- execution realism (backtest) ----------------
SPREAD_POINTS=20
COMMISSION_R=0.10
SLIPPAGE_POINTS=0

# ---------------- risk guardrails ----------------
MAX_CONCURRENT_POSITIONS=3
COOLDOWN_SECONDS=3600
MAX_TRADES_PER_DAY=10
MAX_DAILY_LOSS_PCT=2.0
MAX_DAILY_LOSS_R=3.0
MAX_SPREAD_POINTS=100

# ---------------- loops ----------------
AI_INTERVAL_SEC=60
STREAM_INTERVAL_SEC=1
TRADE_LOGGER_LOOKBACK_DAYS=30

# ---------------- ML ----------------
USE_ML=false
ML_THRESHOLD=0.65
ML_MIN_SAMPLES=1000

# ---------------- storage ----------------
DB_PATH=omniquant.db
