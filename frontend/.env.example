# Copy to .env.local and adjust. .env.local is git-ignored on purpose.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# MUST match AUTH_TOKEN in backend/.env — the backend refuses to trade live
# while this is still the placeholder.
NEXT_PUBLIC_AUTH_TOKEN=change-me
