# Copy to .env.local and adjust. .env.local is git-ignored on purpose.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# MUST match AUTH_TOKEN in backend/.env.
# Generate both at once with:  python backend/tools/setup_env.py
# Remember to restart `npm run dev` — NEXT_PUBLIC_* is baked in at build time.
NEXT_PUBLIC_AUTH_TOKEN=
